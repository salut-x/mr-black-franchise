---
import CtaForm from '@/components/partials/CtaForm.astro'
import Faq from '@/components/partials/Faq.astro'
import Features from '@/components/partials/Features.astro'
import Formats from '@/components/partials/Formats.astro'
import Hero from '@/components/partials/Hero.astro'
import KeyTerms from '@/components/partials/KeyTerms.astro'
import Digital from '@/components/partials/Digital.astro'
import Package from '@/components/partials/Package.astro'
import StickyGallery from '@/components/partials/StickyGallery.astro'
import CupSection from '@/components/ui/CupSection.astro'
import Layout from '@/layouts/BaseLayout.astro'
---

<Layout
	title='Mr.BLACK | Franchise'
	description='Open a Mr.BLACK coffee shop in your city and earn from ₽1,000,000 a year with a 31% margin.'
	headerTheme='light'
	headerOverlay
>
	<div class='hero-transition' data-js-hero-model>
		<div class='hero-transition__model-layer'>
			<div class='hero-transition__model-sticky'>
				<model-viewer class='hero-transition__model' src='/models/cup.glb' alt='3D model of a Mr.BLACK coffee cup' camera-orbit='-20deg 75deg auto' field-of-view='30deg' interaction-prompt='none' orientation='0deg 0deg 0deg' shadow-intensity='0' loading='eager' data-js-hero-model-view></model-viewer>
			</div>
		</div>
		<Hero />
		<Features />
		<Formats />
		<CupSection color='--color-ivory' logo='/models/logo-cup-3.webp' alt='3D model of a branded Mr.BLACK coffee cup' pinTop={300}>
			<Package />
		</CupSection>
		<KeyTerms />
		<Digital />
		<StickyGallery />
		<Faq />
		<CupSection color='--color-orange' logo='/models/logo-cup-4.webp' alt='3D model of an orange Mr.BLACK coffee cup' pinTop={240} pinMaxWidth={1024}>
			<CtaForm />
		</CupSection>
	</div>
</Layout>

<style lang='scss'>
	.hero-transition {
		position: relative;
		isolation: isolate;

		&__model-layer {
			position: absolute;
			z-index: 2;
			inset: 0;
			pointer-events: none;

			@include mobile-only {
				inset: 0 0 auto;
				height: calc(max(844px, 100dvh) + 100svh);
			}
		}

		&__model-sticky { position: sticky; top: 0; display: grid; place-items: center; height: 100svh; }

		&__model {
			display: block;
			width: 70vmin;
			height: 70vmin;
			background-color: transparent;
			transform: translate3d(0, calc(var(--hero-model-start-y, -40px) + var(--hero-model-exit-y, 0px)), 0) scale(var(--hero-model-scale, 1));
			pointer-events: none;
			will-change: transform;
			--poster-color: transparent;

			@include mobile-only {
				--hero-model-scale: 1.3;
				--hero-model-start-y: 10px;

				width: 273px;
				height: 273px;
			}
			@include tablet-only { --hero-model-scale: 0.9; }
		}

		&__model::part(default-progress-bar) { display: none; }
	}
</style>
