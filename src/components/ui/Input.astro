---
import type { InputHTMLAttributes } from 'astro/types'

interface Props extends InputHTMLAttributes {
	label: string
	name: string
}

const {
	label,
	name,
	id = name,
	class: className,
	type = 'text',
	...attributes
} = Astro.props
---

<label
	class:list={['input-field', className]}
	for={id}
>
	<span class='input-field__label txt-btn'>{label}</span>
	<input
		id={id}
		name={name}
		type={type}
		class='input-field__control txt-btn'
		{...attributes}
	/>
	<span
		class='input-field__error txt-btn'
		data-js-form-error
	></span>
</label>

<style lang='scss'>
	.input-field {
		--input-field-gap: 24px;

		display: grid;
		gap: var(--input-field-gap);
		width: 100%;
		color: inherit;

		&__control {
			width: 100%;
			padding: 0 0 21px;
			border: none;
			border-bottom: 1px dashed
				color-mix(in srgb, var(--color-black) 30%, transparent);
			border-radius: 0;
			outline: none;
			background: transparent;
			color: inherit;

			&::placeholder {
				color: inherit;
				opacity: 0.55;
			}

			&:focus-visible {
				border-bottom: 1px dashed var(--color-black);
			}
		}

		&__error {
			margin-top: calc(8px - var(--input-field-gap));

			&:empty {
				display: none;
			}
		}

		&.is-invalid &__control {
			border-bottom: 1px solid var(--color-black);
		}
	}
</style>
