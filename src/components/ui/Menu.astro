---
import { languages } from '@/data/languages.js'
import { mainNavigation } from '@/data/navigation.js'
import ImageButton from './ImageButton.astro'
import Icon from './Icon.astro'
import Link from './Link.astro'
---

<div
	class='main-menu'
	data-js-main-menu
>
	<button
		class='main-menu__toggle'
		type='button'
		aria-label='Открыть меню'
		aria-controls='main-menu-panel'
		aria-expanded='false'
		data-js-main-menu-toggle
	>
		<span
			class='main-menu__label txt-btn'
			data-js-main-menu-label
		>
			Меню
		</span>
		<span
			class='main-menu__icon'
			aria-hidden='true'
			data-js-main-menu-icon
		>
			<span class='main-menu__dots main-menu__dots--closed'>
				{Array.from({ length: 8 }, () => <span class='main-menu__dot' />)}
			</span>
			<span class='main-menu__dots main-menu__dots--open'>
				{Array.from({ length: 5 }, () => <span class='main-menu__dot' />)}
			</span>
		</span>
	</button>

	<div
		class='main-menu__panel'
		id='main-menu-panel'
		aria-hidden='true'
		inert
		data-js-main-menu-panel
	>
		<a
			class='main-menu__logo'
			href='/'
			aria-label='На главную'
		>
			<Icon
				name='logo'
				class='main-menu__logo-image'
			/>
		</a>

		<nav
			class='main-menu__nav'
			aria-label='Мобильная навигация'
		>
			<ul class='main-menu__list'>
				{
					mainNavigation.map(item => (
						<li class='main-menu__item'>
							<a
								class='main-menu__link txt-menu'
								href={item.href}
								data-js-main-menu-link
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<footer class='main-menu__footer'>
			<ImageButton
				class='main-menu__contact'
				label='Связаться'
				theme='dark'
				data-js-main-menu-footer-item
			/>

			<div
				class='main-menu__languages txt-md'
				aria-label='Выбор языка'
				data-js-main-menu-footer-item
			>
				{
					languages.map((language, index) => (
						<>
							<Link
								class:list={[
									'main-menu__language',
									{ 'is-active': language.isActive }
								]}
								href={language.href}
								label={language.label}
								aria-current={language.isActive ? 'page' : undefined}
							/>
							{index < languages.length - 1 && (
								<span aria-hidden='true'>/</span>
							)}
						</>
					))
				}
			</div>
		</footer>
	</div>
</div>

<style lang='scss'>
	@use '../../styles/helpers' as *;

	.main-menu {
		position: relative;
		z-index: 2;

		&__toggle {
			position: relative;
			z-index: 2;
			display: grid;
			grid-template-columns: minmax(0, 1fr) 82px;
			align-items: center;
			width: 170px;
			height: 41px;
			padding: 0;
			border: 0;
			background-color: var(--color-ivory);
			color: var(--color-black);
			cursor: pointer;
			transition: background-color var(--transition-duration);
		}

		&.is-open &__toggle {
			background-color: var(--color-ivory);
		}

		&__label {
			padding-inline: 24px;
			text-align: left;
		}

		&__icon {
			position: relative;
			display: grid;
			place-items: center;
			align-self: stretch;
			border-left: 1px dashed
				color-mix(in srgb, var(--color-black) 30%, transparent);
		}

		&__dots {
			display: grid;
			grid-template-columns: repeat(4, 4px);
			column-gap: 2px;
			row-gap: 3px;
			transition:
				opacity 0.2s ease,
				transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
		}

		:global(.main-menu__dot) {
			width: 4px;
			height: 4px;
			border-radius: 50%;
			background-color: currentColor;
		}

		&__dots--open {
			position: absolute;
			grid-template-columns: repeat(3, 4px);
			grid-template-rows: repeat(3, 4px);
			gap: 2px;
			opacity: 0;
			transform: scale(0.65) rotate(-45deg);
		}

		:global(.main-menu__dots--open .main-menu__dot:nth-child(1)) {
			grid-area: 1 / 1;
		}

		:global(.main-menu__dots--open .main-menu__dot:nth-child(2)) {
			grid-area: 1 / 3;
		}

		:global(.main-menu__dots--open .main-menu__dot:nth-child(3)) {
			grid-area: 2 / 2;
		}

		:global(.main-menu__dots--open .main-menu__dot:nth-child(4)) {
			grid-area: 3 / 1;
		}

		:global(.main-menu__dots--open .main-menu__dot:nth-child(5)) {
			grid-area: 3 / 3;
		}

		&.is-open &__dots--closed {
			opacity: 0;
			transform: scale(0.65) rotate(45deg);
		}

		&.is-open &__dots--open {
			opacity: 1;
			transform: scale(1) rotate(0);
		}

		&__panel {
			position: fixed;
			z-index: 1;
			inset: 0;
			display: none;
			flex-direction: column;
			padding: 146px var(--container-padding-x) 16px;
			box-sizing: border-box;
			background-color: var(--color-ivory);
			color: var(--color-black);
			visibility: hidden;
			will-change: clip-path;
		}

		&__logo {
			position: absolute;
			top: 13.5px;
			left: var(--container-padding-x);
			display: inline-flex;
			width: 41px;
			height: 41px;
			color: var(--color-black);
		}

		:global(.main-menu__logo-image) {
			width: 41px;
			height: 41px;
		}

		&__list {
			margin: 0;
			padding: 0;
			list-style: none;
		}

		&__item {
			overflow: hidden;
			border-bottom: 1px dashed
				color-mix(in srgb, var(--color-black) 25%, transparent);
		}

		&__link {
			display: block;
			font-size: 20px;
			padding-block: 15px 10px;
			transition: none;
			will-change: transform, opacity;
		}

		&__footer {
			display: grid;
			grid-template-columns: auto auto;
			align-items: center;
			justify-content: space-between;
			gap: 24px;
			margin-top: auto;
			padding-top: 16px;
			border-top: 1px dashed
				color-mix(in srgb, var(--color-black) 30%, transparent);
		}

		&__languages {
			display: flex;
			align-items: center;
			gap: 18px;
		}

		:global(.main-menu__language) {
			padding: 0;
			color: inherit;
			opacity: 0.4;
			transition: opacity var(--transition-duration);
		}

		:global(.main-menu__language.is-active) {
			opacity: 1;
		}

		&__toggle:focus-visible,
		&__link:focus-visible {
			outline: 2px dashed currentColor;
			outline-offset: 4px;
		}

		@include mobile-only {
			&__logo {
				display: none;
			}

			&__toggle {
				grid-template-columns: minmax(0, 1fr) 68px;
				max-width: 170px;
			}

			&__footer {
				grid-template-columns: auto auto;
				gap: 16px;
			}

			&__languages {
				gap: 8px;
			}
		}

		@include desktop {
			display: none;
		}
	}
</style>
