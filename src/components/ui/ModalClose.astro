---
interface Props {
	label: string
	class?: string
}

const { label, class: className } = Astro.props
---

<button
	class:list={['modal-close', className]}
	type='button'
	aria-label={label}
	data-modal-close
>
	<span
		class='modal-close__dots'
		aria-hidden='true'
	>
		{Array.from({ length: 5 }, () => <span class='modal-close__dot' />)}
	</span>
</button>

<style lang='scss'>
	.modal-close {
		padding: 8px;
		border: none;
		background: transparent;
		color: inherit;
		cursor: pointer;

		&:focus-visible {
			outline: 2px dashed currentColor;
			outline-offset: 4px;
		}

		&__dots {
			display: grid;
			grid-template-columns: repeat(3, 4px);
			grid-template-rows: repeat(3, 4px);
			gap: 2px;
			transition: transform var(--transition-duration);
		}

		&:hover &__dots {
			transform: rotate(45deg);
		}

		&__dot {
			width: 4px;
			height: 4px;
			border-radius: 50%;
			background-color: currentColor;

			&:nth-child(1) {
				grid-area: 1 / 1;
			}

			&:nth-child(2) {
				grid-area: 1 / 3;
			}

			&:nth-child(3) {
				grid-area: 2 / 2;
			}

			&:nth-child(4) {
				grid-area: 3 / 1;
			}

			&:nth-child(5) {
				grid-area: 3 / 3;
			}
		}
	}
</style>
