---
import cupForm from '@/assets/images/cup-form.png'
import { getCopy } from '@/data/i18n.js'
import CupStill from './CupStill.astro'
import Form from './Form.astro'
import ModalClose from './ModalClose.astro'

const t = getCopy(Astro.url.pathname)
const titleWords = t.cta.title.split(' ')
---

<dialog
	class='modal'
	id='request-modal'
	aria-label={t.cta.title}
	data-lenis-prevent
>
	<CupStill
		image={cupForm}
		width={420}
		class='modal__cup hidden-mobile hidden-tablet'
	/>

	<div class='modal__screen'>
		<div
			class='modal__inner container'
			tabindex='-1'
			autofocus
		>
			<ModalClose
				class='modal__close'
				label={t.a11y.close}
			/>

			<div class='modal__side'>
				<div class='modal__header'>
					<h2 class='modal__title h3'>
						{titleWords.map((word, index) => (
							<>
								<span class='modal__title-word'>
									<span
										class='modal__title-line'
										style={`--modal-title-delay: ${index * 0.08}s`}
									>
										{word}
									</span>
								</span>
								{index < titleWords.length - 1 ? ' ' : ''}
							</>
						))}
					</h2>
					<p class='modal__description txt-md'>{t.cta.description}</p>
				</div>

				<span class='modal__tag txt-btn hidden-mobile hidden-tablet'
					>@MR_BLACK</span
				>
			</div>

			<div class='modal__body'>
				<p class='modal__hint txt-btn'>{t.cta.hint}</p>
				<Form
					idPrefix='modal-'
					submitLabel={t.form.submit}
				/>
			</div>
		</div>
	</div>
</dialog>

<style lang='scss'>
	.modal {
		width: 100%;
		max-width: 100%;
		height: 100%;
		max-height: 100%;
		background: var(--color-orange);
		color: var(--color-black);
		overscroll-behavior: contain;
		overflow-y: auto;
		// Шторка сверху вниз, как у мобильного меню.
		clip-path: inset(0 0 100% 0);
		transition:
			clip-path 0.5s ease-out,
			display 0.5s allow-discrete,
			overlay 0.5s allow-discrete;

		&[open] {
			clip-path: inset(0 0 0 0);
		}

		@starting-style {
			&[open] {
				clip-path: inset(0 0 100% 0);
			}
		}

		&::backdrop {
			background: transparent;
		}

		&__screen {
			display: flex;
			align-items: center;
			min-height: 100%;
			opacity: 0;
			transition: opacity 0.4s ease-out;
		}

		&[open] &__screen {
			opacity: 1;
			transition-delay: 0.25s;
		}

		@starting-style {
			&[open] &__screen {
				opacity: 0;
			}
		}

		&__inner {
			--modal-padding-y: #{fluid(40, 60)};

			position: relative;
			display: grid;
			row-gap: 40px;
			padding-block: var(--modal-padding-y);
			outline: none;

			@include desktop {
				align-self: stretch;
				grid-template-columns: 8fr 4fr;
				column-gap: 20px;
				row-gap: 20px;
			}
		}

		:global(.modal__close) {
			position: absolute;
			top: calc((68px - 32px) / 2);
			right: calc(var(--container-padding-x) - 8px);

			@include desktop {
				top: calc(20px + (65px - 32px) / 2);
			}
		}

		&__side {
			display: contents;

			@include desktop {
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				grid-column: 1;
				grid-row: 1;
				row-gap: 40px;
			}
		}

		&__header {
			display: flex;
			flex-direction: column;
			align-items: start;
			row-gap: fluid(30, 20);
			max-width: 650px;
		}

		&__title-word {
			display: inline-block;
			overflow: hidden;
			vertical-align: bottom;
			padding-block: 0.2em 0.16em;
			margin-block: -0.2em -0.16em;
		}

		&__title-line {
			display: block;
			translate: 0 110%;
			transition: translate 0.6s cubic-bezier(0.22, 1, 0.36, 1);
		}

		&[open] &__title-line {
			translate: 0 0;
			transition-delay: calc(0.25s + var(--modal-title-delay, 0s));
		}

		@starting-style {
			&[open] &__title-line {
				translate: 0 110%;
			}
		}

		&__description {
			max-width: 471px;
		}

		:global(.modal__cup) {
			@include desktop {
				position: absolute;
				inset: 0;
				height: min(48vh, 460px);
				margin: auto;
				translate: 0 80vh;
				transition: translate 0.5s ease-out;
			}
		}

		&[open] :global(.modal__cup) {
			@include desktop {
				translate: 0 0;
			}
		}

		@starting-style {
			&[open] :global(.modal__cup) {
				@include desktop {
					translate: 0 80vh;
				}
			}
		}

		&__body {
			display: grid;
			row-gap: 40px;
			opacity: 0;
			transition: opacity 0.4s ease-out;

			@include desktop {
				align-content: end;
				grid-column: 2;
				grid-row: 1;
			}
		}

		&[open] &__body {
			opacity: 1;
			transition-delay: 0.65s;
		}

		@starting-style {
			&[open] &__body {
				opacity: 0;
			}
		}

		&__hint {
			opacity: 0.55;
		}

		&__tag {
			order: 1;
			opacity: 0.55;
		}
	}
</style>
