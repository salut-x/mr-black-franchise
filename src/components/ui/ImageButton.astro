---
import buttonImage from '@/assets/images/button-img.png'
import buttonImage1 from '@/assets/images/button-img-1.png'
import buttonImage2 from '@/assets/images/button-img-2.png'
import { Image } from 'astro:assets'
import type { ButtonHTMLAttributes } from 'astro/types'
import Icon from './Icon.astro'

const buttonImages = [buttonImage, buttonImage1, buttonImage2]

interface Props extends ButtonHTMLAttributes {
	label: string
	theme?: 'light' | 'dark'
	type?: 'button' | 'submit' | 'reset'
}

const {
	label,
	theme = 'light',
	type = 'button',
	class: className,
	...attributes
} = Astro.props
---

<button
	type={type}
	class:list={['image-button', `image-button--${theme}`, className]}
	{...attributes}
>
	<span
		class='image-button__media'
		aria-hidden='true'
	>
		{
			buttonImages.map((image, index) => (
				<Image
					class='image-button__image'
					src={image}
					alt=''
					densities={[1, 2]}
					style={`--image-button-fade-delay: ${index * 2}s`}
				/>
			))
		}
	</span>
	<div class='image-button__wrapper'>
		<Icon
			name='btn-arrow'
			class='image-button__icon image-button__icon--start'
		/>
		<span class='image-button__label txt-btn'>{label}</span>
		<span class='image-button__icons'>
			<Icon
				name='btn-arrow'
				class='image-button__icon image-button__icon--end'
			/>
		</span>
	</div>
</button>

<style lang='scss'>
	.image-button {
		display: flex;
		align-items: center;
		gap: 0.8em;
		width: var(--image-button-width, 230px);
		padding: 0.3333em;
		border: none;
		font-size: var(--image-button-font-size, 15px);
		cursor: pointer;

		&__wrapper {
			position: relative;
			display: flex;
			align-items: center;
			width: 100%;
		}

		&--light {
			background-color: var(--color-ivory);
			color: var(--color-black);
		}

		&--dark {
			background-color: var(--color-black);
			color: var(--color-white);
		}

		&__media {
			position: relative;
			flex: none;
			width: 4.6667em;
			height: 3.6667em;
			overflow: clip;
		}

		&__image {
			position: absolute;
			inset: 0;
			display: block;
			width: 100%;
			height: 100%;
			object-fit: cover;
			opacity: 0;
			animation: image-button-fade 6s ease infinite;
			animation-delay: var(--image-button-fade-delay);

			@media (prefers-reduced-motion: reduce) {
				opacity: 1;
				animation: none;

				&:not(:first-child) {
					display: none;
				}
			}
		}

		&__label {
			justify-self: center;
			font-size: inherit;
			transition: transform var(--transition-duration-longer)
				cubic-bezier(0.22, 1, 0.36, 1);
			padding-top: 0.2667em;
		}

		&__icons {
			position: relative;
			margin-left: auto;
			width: 0.6em;
			height: 1em;
			margin-right: 0.4667em;
		}

		:global(.image-button__icon) {
			width: 0.6em;
			height: 1em;
		}

		:global(.image-button__icon--start) {
			position: absolute;
			left: 0;
			top: 50%;
			opacity: 0;
			transform: translate(-0.5333em, -50%);
			transition:
				transform var(--transition-duration-longer) cubic-bezier(0.22, 1, 0.36, 1),
				opacity 160ms ease;
		}

		:global(.image-button__icon--end) {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			opacity: 1;
			transform: translateX(0);
			transition:
				transform var(--transition-duration-longer) cubic-bezier(0.22, 1, 0.36, 1),
				opacity 160ms ease;
		}

		&:hover:not(:disabled) :global(.image-button__icon--start) {
			opacity: 1;
			transform: translateY(-50%);
			transition-delay: 120ms;
		}

		&:hover:not(:disabled) :global(.image-button__icon--end) {
			opacity: 0;
			transform: translateX(0.5333em);
		}

		&:hover:not(:disabled) &__label {
			transform: translateX(1.4em);
		}

		&:focus-visible {
			outline: 2px dashed currentColor;
			outline-offset: 4px;
		}

		&:disabled {
			opacity: 0.5;
			cursor: not-allowed;
		}
	}

	@keyframes image-button-fade {
		0%,
		100% {
			opacity: 0;
		}

		6.667%,
		33.333% {
			opacity: 1;
		}

		40% {
			opacity: 0;
		}
	}
</style>
