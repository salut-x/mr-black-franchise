---
import defaultImage from '@/assets/images/button-img.png'
import type { ButtonHTMLAttributes } from 'astro/types'
import Icon from './Icon.astro'

interface Props extends ButtonHTMLAttributes {
	label: string
	theme?: 'light' | 'dark'
	imageSrc?: string
	imageAlt?: string
	type?: 'button' | 'submit' | 'reset'
}

const {
	label,
	theme = 'light',
	imageSrc = defaultImage.src,
	imageAlt = '',
	type = 'button',
	class: className,
	...attributes
} = Astro.props
---

<button
	type={type}
	class:list={['image-button', `image-button--${theme}`, className]}
	{...attributes}
>
	<img
		class='image-button__image'
		src={imageSrc}
		alt={imageAlt}
	/>
	<div class='image-button__wrapper'>
		<Icon
			name='btn-arrow'
			class='image-button__icon image-button__icon--start'
		/>
		<span class='image-button__label txt-btn'>{label}</span>
		<span class='image-button__icons'>
			<Icon
				name='btn-arrow'
				class='image-button__icon image-button__icon--end'
			/>
		</span>
	</div>
</button>

<style lang='scss'>
	.image-button {
		display: flex;
		grid-template-columns: minmax(120px, 30%) 1fr auto;
		align-items: center;
		gap: 12px;
		width: 240px;
		padding: 5px;
		border: none;
		cursor: pointer;

		&__wrapper {
			position: relative;
			display: flex;
			align-items: center;
			width: 100%;
		}

		&--light {
			background-color: var(--color-white);
			color: var(--color-black);
		}

		&--dark {
			background-color: var(--color-black);
			color: var(--color-white);
		}

		&__image {
			display: block;
			width: 70px;
			height: 55px;
			object-fit: cover;
		}

		&__label {
			justify-self: center;
			transition: transform var(--transition-duration-longer)
				cubic-bezier(0.22, 1, 0.36, 1);
			padding-top: 4px;
		}

		&__icons {
			position: relative;
			margin-left: auto;
			width: 9px;
			height: 15px;
			margin-right: 7px;
		}

		:global(.image-button__icon) {
			width: 9px;
			height: 15px;
		}

		:global(.image-button__icon--start) {
			position: absolute;
			left: 0;
			top: 50%;
			opacity: 0;
			transform: translate(-8px, -50%);
			transition:
				transform var(--transition-duration-longer) cubic-bezier(0.22, 1, 0.36, 1),
				opacity 160ms ease;
		}

		:global(.image-button__icon--end) {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			opacity: 1;
			transform: translateX(0);
			transition:
				transform var(--transition-duration-longer) cubic-bezier(0.22, 1, 0.36, 1),
				opacity 160ms ease;
		}

		&:hover:not(:disabled) :global(.image-button__icon--start) {
			opacity: 1;
			transform: translateY(-50%);
			transition-delay: 120ms;
		}

		&:hover:not(:disabled) :global(.image-button__icon--end) {
			opacity: 0;
			transform: translateX(8px);
		}

		&:hover:not(:disabled) &__label {
			transform: translateX(21px);
		}

		&:focus-visible {
			outline: 2px dashed currentColor;
			outline-offset: 4px;
		}

		&:disabled {
			opacity: 0.5;
			cursor: not-allowed;
		}
	}
</style>
