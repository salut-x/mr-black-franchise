---
import type { HTMLAttributes } from 'astro/types'
import Icon from './Icon.astro'

interface Props extends HTMLAttributes<'details'> {
	title: string
	number?: string
}

const { title, number, class: className, ...attributes } = Astro.props
---

<details
	class:list={['accordion', className]}
	data-js-accordion
	{...attributes}
>
	<summary
		class='accordion__summary'
		data-js-accordion-summary
	>
		<span class='accordion__number txt-btn'>{number}</span>
		<span class='accordion__title txt-btn'>{title}</span>
		<Icon
			name='accordion-x'
			class='accordion__icon'
		/>
	</summary>
	<div
		class='accordion__content'
		data-js-accordion-content
	>
		<div class='accordion__content-inner'>
			<slot />
		</div>
	</div>
</details>

<style lang='scss'>
	@use '../../styles/helpers' as *;

	.accordion {
		width: 100%;
		border-top: 1px dashed
			color-mix(in srgb, var(--color-ivory) 30%, transparent);

		&__summary {
			display: grid;
			grid-template-columns: 140px minmax(0, 1fr) 24px;
			align-items: center;
			gap: 24px;
			padding-block: 20px 30px;
			cursor: pointer;
			list-style: none;

			&::-webkit-details-marker {
				display: none;
			}
		}

		&__number {
			align-self: start;
		}

		:global(.accordion__icon) {
			justify-self: end;
			width: 20px;
			height: 20px;
		}

		:global(.accordion-icon__dot) {
			transform-box: view-box;
			transform-origin: center;
			transition:
				transform var(--transition-duration-longer) cubic-bezier(0.22, 1, 0.36, 1),
				opacity var(--transition-duration-longer) ease;
		}

		&[data-expanded='true'] :global(.accordion-icon__dot--top) {
			transform: translateY(9px);
			opacity: 0;
		}

		&[data-expanded='true'] :global(.accordion-icon__dot--bottom) {
			transform: translateY(-9px);
			opacity: 0;
		}

		&__content {
			display: grid;
			grid-template-columns: 140px minmax(0, 1fr) 24px;
			gap: 24px;
			padding: 0 0 36px;
			border-bottom: 1px dashed
				color-mix(in srgb, var(--color-ivory) 30%, transparent);
			box-sizing: border-box;
			overflow: hidden;
		}

		&__content-inner {
			grid-column: 2;
			max-width: 680px;
			opacity: 0;
			transform: translateY(12px);
			transition:
				opacity var(--transition-duration-longer) ease,
				transform var(--transition-duration-longer) cubic-bezier(0.22, 1, 0.36, 1);
		}

		&[data-expanded='true'] &__content-inner {
			opacity: 1;
			transform: translateY(0);
		}

		&__summary:focus-visible {
			outline: 2px dashed currentColor;
			outline-offset: -2px;
		}

		@include mobile-only {
			&__summary,
			&__content {
				grid-template-columns: 48px minmax(0, 1fr) 16px;
				gap: 12px;
			}

			&__summary {
				padding-block: 18px 24px;
			}
		}
	}
</style>

<script>
	const accordions = document.querySelectorAll<HTMLDetailsElement>('[data-js-accordion]')
	const duration = 600
	const easing = 'cubic-bezier(0.22, 1, 0.36, 1)'

	accordions.forEach(accordion => {
		const summary = accordion.querySelector<HTMLElement>('[data-js-accordion-summary]')
		const content = accordion.querySelector<HTMLElement>('[data-js-accordion-content]')

		if (!summary || !content) return

		let animation: Animation | undefined
		let isClosing = false
		accordion.dataset.expanded = String(accordion.open)

		const finish = (open: boolean) => {
			accordion.open = open
			accordion.style.height = ''
			accordion.style.overflow = ''
			animation = undefined
			isClosing = false
		}

		const close = () => {
			if (!accordion.open && !animation) return

			const startHeight = accordion.getBoundingClientRect().height
			animation?.cancel()
			isClosing = true
			accordion.dataset.expanded = 'false'
			accordion.style.height = `${startHeight}px`
			accordion.style.overflow = 'hidden'

			const currentAnimation = accordion.animate(
				[
					{ height: `${startHeight}px` },
					{ height: `${summary.offsetHeight}px` }
				],
				{ duration, easing }
			)
			animation = currentAnimation
			currentAnimation.onfinish = () => {
				if (animation === currentAnimation) finish(false)
			}
		}

		const open = () => {
			const startHeight = accordion.getBoundingClientRect().height
			animation?.cancel()
			isClosing = false
			accordion.dataset.expanded = 'true'
			accordion.style.height = `${startHeight}px`
			accordion.style.overflow = 'hidden'
			accordion.open = true

			const endHeight = summary.offsetHeight + content.offsetHeight
			const currentAnimation = accordion.animate(
				[
					{ height: `${startHeight}px` },
					{ height: `${endHeight}px` }
				],
				{ duration, easing }
			)
			animation = currentAnimation
			currentAnimation.onfinish = () => {
				if (animation === currentAnimation) finish(true)
			}
		}

		accordion.addEventListener('accordion:close', close)

		summary.addEventListener('click', event => {
			event.preventDefault()

			if (accordion.open && !isClosing) {
				close()
				return
			}

			const group = accordion.closest('[data-js-accordion-list]')
			group?.querySelectorAll<HTMLDetailsElement>(':scope > [data-js-accordion]').forEach(item => {
				if (item !== accordion && item.open) {
					item.dispatchEvent(new CustomEvent('accordion:close'))
				}
			})

			open()
		})
	})
</script>
