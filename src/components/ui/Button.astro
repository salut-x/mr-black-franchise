---
import type { ButtonHTMLAttributes } from 'astro/types'
import Icon from './Icon.astro'

interface Props extends ButtonHTMLAttributes {
	type?: 'button' | 'submit' | 'reset'
	label: string
	labelClass?: string
}

const {
	type = 'button',
	class: className,
	label,
	labelClass,
	...attributes
} = Astro.props
---

<button
	type={type}
	class:list={['button', className]}
	{...attributes}
>
	<Icon
		name='btn-arrow'
		class='button__icon button__icon--start'
	/>
	<Icon
		name='btn-arrow'
		class='button__icon button__icon--end'
	/>
	<span
		class:list={[
			'button__label',
			'button__label--underlined',
			'txt-btn',
			labelClass,
		]}
	>
		{label}
	</span>
</button>

<style lang='scss'>
	.button {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-self: start;
		width: fit-content;
		padding: 0 21px;
		border: none;
		background: transparent;
		color: inherit;
		cursor: pointer;

		:global(.button__icon) {
			position: absolute;
			margin-top: 3px;
			top: 25%;
			width: 9px;
			height: 15px;
		}

		:global(.button__icon--start) {
			left: 0;
			opacity: 1;
			transform: translateY(-50%);
			transition:
				transform var(--transition-duration-longer) cubic-bezier(0.22, 1, 0.36, 1),
				opacity 160ms ease;
		}

		:global(.button__icon--end) {
			left: calc(100% - 9px);
			opacity: 0;
			transform: translate(-12px, -50%);
			transition:
				transform var(--transition-duration-longer) cubic-bezier(0.22, 1, 0.36, 1),
				opacity 160ms ease;
		}

		&__label {
			position: relative;
			display: inline-block;
			transition: transform var(--transition-duration-longer) ease;
		}

		&__label--underlined::after {
			content: '';
			position: absolute;
			left: 0;
			bottom: 0em;
			width: 100%;
			height: 1px;
			background-color: currentColor;
			transform: scaleX(1);
			transform-origin: right;
			transition: transform var(--transition-duration-longer) ease;
		}

		@include hover(false) {
			&:not(:disabled) {
				.button__label::after {
					transform: scaleX(0);
				}

				:global(.button__icon--start) {
					transform: translate(12px, -50%);
					opacity: 0;
				}

				:global(.button__icon--end) {
					opacity: 1;
					transform: translateY(-50%);
					transition-delay: 120ms;
				}
			}
		}

		&:focus-visible {
			outline: 2px dashed currentColor;
			outline-offset: 4px;
		}

		&:disabled {
			opacity: 0.5;
			cursor: not-allowed;
		}
	}
</style>
