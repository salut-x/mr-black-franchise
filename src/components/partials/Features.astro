---
import { getCopy } from '@/data/i18n.js'
import FeaturesCard from '../ui/FeaturesCard.astro'

const t = getCopy(Astro.url.pathname)
const features = t.features
---

<section
	id='about'
	class='features'
	data-js-hero-model-features
	data-js-hero-model-interaction
	data-header-theme='dark'
>
	<div class='features__inner container'>
		<h2 class='features__title h4'>{t.featuresTitle}</h2>
		<div class='features__content'>
			<ul class='features__list--left'>
				{
					features
						.filter((_, index) => index % 2 === 0)
						.map(feature => (
							<li class='features__item'>
								<FeaturesCard {...feature} />
							</li>
						))
				}
			</ul>
			<ul class='features__list--right'>
				{
					features
						.filter((_, index) => index % 2 === 1)
						.map(feature => (
							<li class='features__item'>
								<FeaturesCard {...feature} />
							</li>
						))
				}
			</ul>
		</div>
	</div>
</section>

<style lang='scss'>
	.features {
		background: var(--color-green);
		padding-block: 100px;

		@include tablet {
			padding-block: 120px;
		}

		@include desktop {
			padding-block: 130px 150px;
		}

		&__title {
			@include tablet {
				max-width: 500px;
			}
		}

		&__content {
			display: flex;
			flex-direction: column;
			row-gap: 60px;
			margin-top: 480px;

			@include tablet {
				flex-direction: row;
				justify-content: space-between;
				margin-top: 90px;
			}
		}

		&__list {
			&--left {
				display: flex;
				flex-direction: column;
				row-gap: 60px;

				@include tablet {
					max-width: 235px;
					row-gap: 200px;
				}

				@include desktop {
					max-width: 370px;
				}
			}
			&--right {
				display: grid;
				row-gap: 60px;

				@include tablet {
					margin-top: 200px;
					max-width: 235px;
					row-gap: 200px;
				}

				@include desktop {
					max-width: 370px;
				}
			}
		}
	}
</style>
