---
import Button from '../ui/Button.astro'
import { getCopy } from '@/data/i18n.js'

const t = getCopy(Astro.url.pathname)
---

<section
	class='hero'
	data-js-hero-model-interaction
	data-header-theme='light'
>
	<div class='hero__inner container'>
		<div class='hero__content'>
			<div class='hero__offer'>
				<h1 class='hero__title h6'>{t.hero.title}</h1>
				<p class='hero__description'>{t.hero.description}</p>
				<Button label={t.common.apply} />
			</div>
			<div class='hero__points'>
				<ul class='hero__points-list'>
					{t.hero.points.map(([value, descriptor]) => <li class='hero__points-item'><span class='hero__points-number h6'>{value}</span><span class='hero__points-descriptor'>{descriptor}</span></li>)}
				</ul>
			</div>
		</div>
		<div
			class='hero__brand'
			aria-hidden='true'
		>
			<div class='hero__brand-track'>
				{
					Array.from({ length: 2 }, (_, index) => (
						<div
							class:list={[
								'hero__brand-item',
								{ 'hero__brand-item--clone': index === 1 }
							]}
						>
							<span class='hero__wordmark' />
							<svg
								class='hero__cup'
								viewBox='0 0 320 124'
								fill='none'
								focusable='false'
							>
								<path
									class='hero__cup-shape'
									d='M53.1637 0.557126L288.368 48.0041C289.52 48.2364 290.414 49.1696 290.602 50.3405L294.309 80.1644L294.353 80.522L294.402 80.5319C294.745 81.9529 295.892 83.0591 297.359 83.355L317.068 87.3309C318.613 87.6425 319.593 89.1368 319.289 90.644L313.256 120.549C312.949 122.075 311.452 123.051 309.925 122.743L301.873 121.118C295.652 119.863 289.745 117.465 284.207 114.346C277.024 110.296 260.896 104.809 239.082 98.821C217.245 92.8272 189.654 86.3177 159.502 80.2352C129.35 74.1528 101.393 69.4618 78.9396 66.5241C56.5095 63.5894 39.516 62.3956 31.327 63.3321L31.3258 63.3329C25.0117 64.0614 18.6375 63.9822 12.4159 62.7272L2.77615 60.7826C1.23125 60.4709 0.251358 58.9767 0.555418 57.4694L6.58813 27.564C6.89584 26.0386 8.39295 25.0629 9.91961 25.3709L31.1942 29.6625C32.7617 29.9787 34.3677 29.2775 35.2121 27.9137L35.2165 27.9067L35.22 27.8994L50.1981 1.84477C50.7996 0.83878 51.9834 0.319131 53.1637 0.557126Z'
								/>
							</svg>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>

<style lang='scss'>
	.hero {
		position: relative;
		overflow: hidden;
		min-height: 100svh;
		background: var(--color-black);

		@include mobile-only {
			min-height: 844px;

			@media (min-height: 845px) {
				min-height: 100dvh;
			}
		}

		&__inner {
			position: relative;
			display: grid;
			min-height: 100svh;

			@include mobile-only {
				min-height: 844px;

				@media (min-height: 845px) {
					min-height: 100dvh;
				}
			}
		}

		&__content {
			position: relative;
			z-index: 1;
			display: grid;
			align-self: start;
			row-gap: 216px;

			@include mobile-only {
				z-index: auto;
				padding-bottom: 200px;
			}

			@include tablet-only {
				padding-bottom: 250px;
			}

			@include desktop {
				display: flex;
				justify-content: space-between;
			}
		}

		&__offer {
			color: var(--color-ivory);
			margin-top: 120px;
			max-width: 353px;

			@include mobile-only {
				position: relative;
				z-index: 3;
			}

			@include desktop {
				max-width: 471px;
				margin-top: 150px;
			}
		}

		&__description {
			margin-block: 10px 30px;
		}

		&__points {
			color: var(--color-ivory);

			@include mobile-only {
				position: relative;
				z-index: 1;
			}

			@include tablet-only {
				justify-self: end;
			}

			&-list {
				display: flex;
				flex-direction: column;
				row-gap: 30px;

				@include desktop {
					row-gap: 40px;
					margin-top: 270px;
				}
			}
			&-item {
				display: grid;
				row-gap: 10px;
			}
		}

		&__brand {
			--hero-brand-item-width: 1173px;
			--hero-brand-gap: 60px;
			--hero-brand-c-position: 928.5px;
			--hero-brand-start-position: 68vw;

			position: absolute;
			z-index: 1;
			bottom: 0;
			left: 50%;
			width: 100vw;
			height: 160px;
			transform: translateX(-50%);
			pointer-events: none;

			@include tablet-only {
				--hero-brand-item-width: 1540px;
				--hero-brand-c-position: 1219px;

				height: 210px;
			}

			@include desktop {
				right: var(--container-padding-x);
				left: var(--container-padding-x);
				width: auto;
				height: auto;
				aspect-ratio: 1173 / 160;
				transform: none;
			}
		}

		&__brand-track {
			position: absolute;
			bottom: 0;
			left: 0;
			display: flex;
			gap: var(--hero-brand-gap);
			width: max-content;
			height: 160px;
			animation: hero-brand-marquee 12s linear infinite;
			will-change: transform;

			@include tablet-only {
				height: 210px;
			}

			@include desktop {
				bottom: 20px;
				left: 0;
				width: 100%;
				height: 100%;
				animation: none;
				transform: none;
			}
		}

		&__brand-item {
			position: relative;
			flex: 0 0 var(--hero-brand-item-width);
			width: var(--hero-brand-item-width);
			height: 160px;

			@include tablet-only {
				height: 210px;
			}

			@include desktop {
				flex-basis: 100%;
				width: 100%;
				height: 100%;
			}
		}

		&__brand-item--clone {
			@include desktop {
				display: none;
			}
		}

		&__wordmark {
			position: absolute;
			inset: 0;
			display: block;
			width: 100%;
			height: 100%;
			background-color: var(--color-ivory);
			mask-image: url('/header-line.svg');
			mask-repeat: no-repeat;
			mask-size: 100% 100%;
			-webkit-mask-image: url('/header-line.svg');
			-webkit-mask-repeat: no-repeat;
			-webkit-mask-size: 100% 100%;
		}

		&__cup {
			position: absolute;
			z-index: 1;
			top: -35px;
			left: 79.16%;
			display: block;
			width: 200px;
			height: auto;
			overflow: visible;
			transform: translateX(-50%);

			@include tablet-only {
				top: -55px;
				width: 320px;
			}

			@include desktop {
				top: -50px;
				right: auto;
				left: 79.16%;
				width: 300px;
				transform-origin: center;
				animation: hero-cup-float 10s ease-in-out infinite;
			}
		}

		&__cup-shape {
			fill: var(--color-black);
			stroke: var(--color-ivory);
		}
	}

	@keyframes hero-brand-marquee {
		from {
			transform: translate3d(
				calc(var(--hero-brand-start-position) - var(--hero-brand-c-position)),
				0,
				0
			);
		}

		to {
			transform: translate3d(
				calc(
					var(--hero-brand-start-position) - var(--hero-brand-c-position) - var(
							--hero-brand-item-width
						) - var(--hero-brand-gap)
				),
				0,
				0
			);
		}
	}

	@keyframes hero-cup-float {
		0%,
		100% {
			transform: translateX(-50%) translateY(-5px) rotate(-3deg);
		}

		50% {
			transform: translateX(-50%) translateY(5px) rotate(3deg);
		}
	}
</style>
