---
import { getCopy, getLanguages, getNavigation } from '@/data/i18n.js'
import Icon from '../ui/Icon.astro'
import ImageButton from '../ui/ImageButton.astro'
import Link from '../ui/Link.astro'
import MainMenu from '../ui/Menu.astro'

interface Props {
	theme?: 'light' | 'dark'
	overlay?: boolean
}

const { theme = 'light', overlay = false } = Astro.props
const t = getCopy(Astro.url.pathname)
const languages = getLanguages(Astro.url.pathname)
const mainNavigation = getNavigation(Astro.url.pathname)
const homeHref = Astro.url.pathname.startsWith('/en') ? '/en' : '/'

const contactsLink = mainNavigation.find(({ href }) => href === '#contacts')
const desktopNavigation = mainNavigation.filter(
	({ href }) => href !== '#contacts'
)
---

<header
	class:list={[
		'header',
		`header--${theme}`,
		{ 'header--overlay': overlay },
	]}
	data-js-header
>
	<div class='header__inner container'>
		<nav
			class='header__desktop-nav'
			aria-label={t.a11y.mainNav}
		>
			<ul class='header__desktop-list'>
				{
					desktopNavigation.map(item => (
						<li class='header__desktop-item'>
							<Link
								href={item.href}
								label={item.label}
							/>
						</li>
					))
				}
			</ul>
		</nav>

		{
			contactsLink && (
				<nav
					class='header__tablet-nav'
					aria-label={t.a11y.extraNav}
				>
					<ul class='header__tablet-list'>
						<li>
							<Link
								href={contactsLink.href}
								label={contactsLink.label}
							/>
						</li>
						<li
							class='header__languages'
							aria-label={t.a11y.language}
						>
							{languages.map((language, index) => (
								<>
									<Link
										class:list={[
											'header__language',
											{ 'is-active': language.isActive }
										]}
										href={language.href}
										label={language.label}
										aria-current={language.isActive ? 'page' : undefined}
									/>
									{index < languages.length - 1 && (
										<span aria-hidden='true'>/</span>
									)}
								</>
							))}
						</li>
					</ul>
				</nav>
			)
		}
		<a
			class='header__logo'
			href={homeHref}
			aria-label={t.a11y.home}
		>
			<Icon
				name='logo'
				class='header__logo-image'
			/>
		</a>

		<MainMenu />

		<div class='header__desktop-actions'>
			{
				contactsLink && (
					<div class='header__desktop-contact'>
						<Link
							href={contactsLink.href}
							label={contactsLink.label}
						/>
					</div>
				)
			}

			<div
				class='header__desktop-languages txt-menu'
				aria-label={t.a11y.language}
			>
				{
					languages.map((language, index) => (
						<>
							<Link
								class:list={[
									'header__desktop-language',
									{ 'is-active': language.isActive }
								]}
								href={language.href}
								label={language.label}
								aria-current={language.isActive ? 'page' : undefined}
							/>
							{index < languages.length - 1 && (
								<span aria-hidden='true'>/</span>
							)}
						</>
					))
				}
			</div>

			<ImageButton
				class='header__contact-button'
				label={t.common.contact}
				theme={theme === 'dark' ? 'light' : 'dark'}
				data-modal-open='request-modal'
			/>
		</div>
	</div>
</header>

<style lang='scss'>
	.header {
		position: sticky;
		top: 0;
		z-index: 20;
		transition:
			transform var(--transition-duration) ease,
			opacity var(--transition-duration) ease,
			visibility var(--transition-duration),
			color var(--transition-duration),
			background-color var(--transition-duration);

		&--light {
			// background-color: var(--color-ivory);
			color: var(--color-ivory);
		}

		&--dark {
			// background-color: var(--color-black);
			color: var(--color-black);
		}

		&--none {
			opacity: 0;
			visibility: hidden;
			pointer-events: none;
		}

		&--overlay {
			position: fixed;
			right: 0;
			left: 0;
		}

		&__inner {
			min-height: 68px;
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 24px;

			@include tablet-only {
				position: relative;
			}
			@include desktop {
				position: relative;
				align-items: flex-start;
				min-height: 65px;
				padding-top: 20px;
			}
		}
		&__logo {
			position: relative;
			z-index: 3;
			display: inline-flex;
			color: inherit;

			@include tablet-only {
				position: absolute;
				top: 50%;
				left: 50%;
				transform: translate(-50%, -50%);
			}
			@include desktop {
				position: absolute;
				top: 20px;
				left: 50%;
				transform: translateX(-50%);
			}
		}

		:global(.header:has(.main-menu.is-panel-visible)) &__logo {
			color: var(--color-black);
			transition: none;

			@include tablet-only {
				opacity: 0;
				visibility: hidden;
				pointer-events: none;
			}
		}

		:global(.header:has(.main-menu.is-panel-visible))
			:global(.header__logo-image .icon__shape) {
			transition: none;
		}

		:global(.header__logo-image) {
			width: 41px;
			height: 41px;
			color: inherit;
		}
		&__tablet-nav {
			display: none;

			@include tablet-only {
				display: block;
			}
		}

		&__desktop-nav {
			display: none;

			@include desktop {
				display: block;
			}
		}

		&__desktop-actions {
			display: none;

			@include desktop {
				display: flex;
				align-items: flex-start;
				gap: 40px;
				margin-left: auto;
			}
		}

		&__tablet-list {
			display: flex;
			align-items: center;
			gap: 24px;
			margin: 0;
			padding: 0;
			list-style: none;

			@include tablet-only {
				gap: 40px;
			}
		}

		&__desktop-list {
			@include desktop {
				display: flex;
				align-items: center;
				gap: 40px;
				margin: 0;
				padding: 0;
				list-style: none;
			}
		}

		&__languages {
			display: flex;
			align-items: baseline;
			gap: 8px;
		}

		&__desktop-languages {
			@include desktop {
				display: flex;
				align-items: flex-start;
				gap: 8px;
			}
		}

		:global(.header__language) {
			padding: 0;
			opacity: 0.4;
		}

		:global(.header__language.is-active) {
			opacity: 1;
		}

		:global(.header__desktop-item) {
			@include desktop {
				display: flex;
			}
		}

		:global(.header__desktop-contact) {
			@include desktop {
				display: flex;
			}
		}

		:global(.header__desktop-language) {
			@include desktop {
				padding: 0;
				opacity: 0.4;
			}
		}

		:global(.header__desktop-language.is-active) {
			@include desktop {
				opacity: 1;
			}
		}

		:global(.main-menu) {
			@include tablet-only {
				margin-left: auto;
			}
		}

	}

	@media (width >= 1600px) {
		.header__inner {
			display: grid;
			grid-template-columns: repeat(12, minmax(0, 1fr));
			column-gap: 20px;
			align-items: start;
			container-type: inline-size;
		}

		.header__desktop-nav {
			display: grid;
			grid-template-columns: subgrid;
			grid-column: 1 / span 4;
			column-gap: 20px;
		}

		.header__logo {
			position: static;
			grid-column: 5 / span 4;
			justify-self: center;
			transform: none;
		}

		.header__desktop-list {
			display: grid;
			grid-template-columns: subgrid;
			grid-column: 1 / -1;
			column-gap: 20px;
		}

		.header__desktop-actions {
			display: grid;
			grid-template-columns: subgrid;
			grid-column: 9 / -1;
			column-gap: 20px;
			margin-left: 0;
		}

		:global(.header__desktop-contact) {
			grid-column: 1;
		}

		.header__desktop-languages {
			grid-column: 2;
			justify-self: start;
		}

		:global(.header__contact-button) {
			--image-button-width: 100%;
			--image-button-font-size: calc(1.0417cqi - 1.0417px);

			grid-column: 3 / -1;
		}
	}

	:global(.header--light .header__contact-button) {
		background-color: var(--color-ivory);
		color: var(--color-black);
	}

	:global(.header--dark .header__contact-button) {
		background-color: var(--color-black);
		color: var(--color-white);
	}

	:global(.header--dark .main-menu:not(.is-open) .main-menu__toggle) {
		background-color: var(--color-black);
		color: var(--color-ivory);
	}

	:global(.header--dark .main-menu:not(.is-open) .main-menu__icon) {
		border-left-color: color-mix(
			in srgb,
			var(--color-ivory) 30%,
			transparent
		);
	}

	:global(.header:has(.main-menu.is-panel-visible)) {
		transform: none;
		transition: none;
	}
</style>
