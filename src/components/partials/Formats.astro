---
import formatImage1 from '@/assets/images/formats/1-1.jpg'
import formatImage12 from '@/assets/images/formats/1-2.jpg'
import formatImage2 from '@/assets/images/formats/2-1.jpg'
import formatImage22 from '@/assets/images/formats/2-2.jpg'
import formatImage3 from '@/assets/images/formats/3-1.jpg'
import formatImage32 from '@/assets/images/formats/3-2.jpg'
import FormatSlide from '../ui/FormatSlide.astro'
import { getCopy } from '@/data/i18n.js'

const t = getCopy(Astro.url.pathname)

const slides = [
	{
		image: formatImage1,
		title: 'To go',
		description: t.formats[0].description,
		number: '01',
		metrics: t.formats[0].metrics.map(([caption, point]) => ({ caption, point })),
		minimage: formatImage12,
		background: 'var(--color-ivory)'
	},
	{
		image: formatImage2,
		title: 'LOUNGE',
		number: '02',
		description: t.formats[1].description,
		metrics: t.formats[1].metrics.map(([caption, point]) => ({ caption, point })),
		minimage: formatImage22,
		background: 'var(--color-white)'
	},
	{
		image: formatImage3,
		title: 'specialty',
		number: '03',
		description: t.formats[2].description,
		metrics: t.formats[2].metrics.map(([caption, point]) => ({ caption, point })),
		minimage: formatImage32,
		background: 'var(--color-green)'
	}
]
---

<section
	id='formats'
	class='formats'
	data-js-hero-model-formats
	data-js-hero-model-interaction
	data-header-theme='none'
>
	<div
		class='formats__inner'
		data-js-formats
	>
		{slides.map(slide => <FormatSlide {...slide} />)}
	</div>
</section>

<style lang='scss'>
	.formats {
		position: relative;
		z-index: 10;
		background: var(--color-ivory);

		&__inner {
			position: relative;

			@include tablet {
				height: 100vh;
				height: 100lvh;
				overflow: hidden;
			}

			@media (prefers-reduced-motion: reduce) {
				height: auto;
			}
		}
	}
</style>
