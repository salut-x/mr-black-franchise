---
import CookieBanner from '@/components/partials/CookieBanner.astro'
import Head from '@/components/partials/Head.astro'
import Header from '@/components/partials/Header.astro'
import Footer from '@/components/partials/Footer.astro'
import LegalModal from '@/components/ui/LegalModal.astro'
import Modal from '@/components/ui/Modal.astro'
import Preloader from '@/components/partials/Preloader.astro'
import { getCopy, getLocale } from '@/data/i18n.js'
import { getLegal } from '@/data/legal.js'

interface Props {
	title?: string
	description?: string
	headerTheme?: 'light' | 'dark'
	headerOverlay?: boolean
	footer?: boolean
}

const {
	title = 'Astro Starter',
	description = '',
	headerTheme = 'light',
	headerOverlay = false,
	footer = true,
} = Astro.props

const t = getCopy(Astro.url.pathname)
const legal = getLegal(Astro.url.pathname)
---

<html
	class='page'
	id='top'
	lang={getLocale(Astro.url.pathname)}
>
	<Head title={title} description={description} />
	<body class='page__body'>
		<Preloader />
		<Header
			theme={headerTheme}
			overlay={headerOverlay}
		/>
		<main
			class='page__main'
			id='main-content'
		>
			<slot />
		</main>
		{footer && <Footer />}
		<Modal />
		<LegalModal
			id='legal-terms'
			closeLabel={t.a11y.close}
			document={legal.terms}
		/>
		<LegalModal
			id='legal-privacy'
			closeLabel={t.a11y.close}
			document={legal.privacy}
		/>
		<CookieBanner />
	</body>
</html>
