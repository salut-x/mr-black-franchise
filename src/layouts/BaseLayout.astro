---
import CookieBanner from '@/components/partials/CookieBanner.astro'
import Head from '@/components/partials/Head.astro'
import Header from '@/components/partials/Header.astro'
import Footer from '@/components/partials/Footer.astro'
import Modal from '@/components/ui/Modal.astro'
import Preloader from '@/components/partials/Preloader.astro'
import { getLocale } from '@/data/i18n.js'

interface Props {
	title?: string
	description?: string
	headerTheme?: 'light' | 'dark'
	headerOverlay?: boolean
}

const {
	title = 'Astro Starter',
	description = '',
	headerTheme = 'light',
	headerOverlay = false,
} = Astro.props
---

<html
	class='page'
	id='top'
	lang={getLocale(Astro.url.pathname)}
>
	<Head title={title} description={description} />
	<body class='page__body'>
		<Preloader />
		<Header
			theme={headerTheme}
			overlay={headerOverlay}
		/>
		<main
			class='page__main'
			id='main-content'
		>
			<slot />
		</main>
		<Footer />
		<Modal />
		<CookieBanner />
	</body>
</html>
